# Copy to .env and replace every placeholder with independently generated URL-safe secrets.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
BF_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
BF_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
BF_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
APP_ENV=development
API_PORT=8000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_SESSION_DAYS=30
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCKOUT_MINUTES=15
# Disabled by default; hard-blocked under APP_ENV=production.
# Set true only for an authorized, isolated M14 test deployment.
FINANCE_SOURCE_INTAKE_ENABLED=false
# Experimental Core Financials management-reporting slice; default-disabled and hard-blocked in production.
CORE_FINANCIALS_ENABLED=false
# Experimental M15 exact-subtotal prototype; requires the M14 flag above.
# Default-disabled and hard-blocked when APP_ENV=production; no accounting/production approval.
FINANCIAL_CALCULATIONS_ENABLED=false
# Experimental M16 direct-cash schedule; requires both M14 and M15 flags above.
# Default-disabled and hard-blocked in production; no cash-source or retention approval.
DIRECT_CASH_FORECASTS_ENABLED=false
# Experimental M17 baseline forecasting and evaluation; default-disabled and blocked in production.
# Inputs are caller assertions unless independently verified by a separate source integration.
FORECASTING_ENABLED=false
# Human non-production decisions only; production activation remains blocked pending governance.
FORECAST_PROMOTION_ENABLED=false
# Optional report export prototype for explicitly authorized, isolated non-production data only.
# Default-disabled; APP_ENV=production remains hard-blocked even if this flag is enabled.
REPORT_EXPORTS_ENABLED=false
IMPORT_MAX_FILE_BYTES=26214400
IMPORT_MAX_ROWS=10000
IMPORT_STAGING_TTL_HOURS=24
# Optional: approved local connector root; provision <root>/<company-uuid>/ directories per Company.
UNIVERSAL_LOCAL_CONNECTOR_ROOT=
